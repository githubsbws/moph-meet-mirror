{
  "expo": {
    "name": "MOPH Meet",
    "slug": "moph-meet",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mophmeet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "th.go.moph.meet",
      "infoPlist": {
        "NSCameraUsageDescription": "MOPH Meet ต้องการใช้กล้องสำหรับวิดีโอคอล",
        "NSMicrophoneUsageDescription": "MOPH Meet ต้องการใช้ไมโครโฟนสำหรับวิดีโอคอล"
      }
    },
    "android": {
      "package": "th.go.moph.meet",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1b7a43"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1b7a43"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
