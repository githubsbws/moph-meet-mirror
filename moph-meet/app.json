{
  "expo": {
    "name": "MOPH Meet",
    "slug": "moph-meet",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mophmeet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "buildNumber": "1",
      "supportsTablet": true,
      "bundleIdentifier": "th.go.moph.moph-meet",
      "infoPlist": {
        "NSCameraUsageDescription": "MOPH Meet ต้องการใช้กล้องสำหรับวิดีโอคอล",
        "NSMicrophoneUsageDescription": "MOPH Meet ต้องการใช้ไมโครโฟนสำหรับวิดีโอคอล",
        "ITSAppUsesNonExemptEncryption": false,
        "NSBluetoothPeripheralUsageDescription": "ใช้ Bluetooth เพื่อเชื่อมต่ออุปกรณ์ทางการแพทย์ (TOR 4.10.6)",
        "NSBluetoothAlwaysUsageDescription": "ใช้ Bluetooth เพื่อเชื่อมต่ออุปกรณ์ทางการแพทย์ (TOR 4.10.6)"
      }
    },
    "android": {
      "package": "th.go.moph.meet",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withUnsafeOkHttp",
      "./plugins/withFrescoFlags",
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 35,
            "compileSdkVersion": 35
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1b7a43"
        }
      ],
      "expo-secure-store",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ]
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2ba5fef6-62ca-4a4b-ac91-5775592a4df6"
      }
    }
  }
}
