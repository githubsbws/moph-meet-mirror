<%- include('partials/head', { title: 'รอตรวจ – MOPH Meet' }) %>

<style>
  body { font-family: 'Sarabun', sans-serif; background: #f0faf4; min-height: 100vh; margin: 0; }

  /* Queue waiting view */
  #queue-view {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    min-height: 100vh; padding: 2rem; text-align: center;
  }
  .queue-card {
    background: #fff; border-radius: 1rem; padding: 2.5rem 2rem;
    box-shadow: 0 4px 24px rgba(5,104,57,.1); max-width: 400px; width: 100%;
  }
  .queue-logo { color: #056839; font-size: 3rem; margin-bottom: .5rem; }
  .queue-title { font-size: 1.25rem; font-weight: 700; color: #056839; margin: 0 0 .25rem; }
  .queue-room { font-size: .9rem; color: #6b7280; margin: 0 0 1.5rem; }
  .queue-num-box {
    background: #f0fdf4; border: 2px solid #056839; border-radius: .75rem;
    padding: 1.25rem; margin-bottom: 1rem;
  }
  .queue-num-label { font-size: .8rem; color: #6b7280; margin: 0 0 .25rem; }
  .queue-num-val { font-size: 3rem; font-weight: 800; color: #056839; line-height: 1; margin: 0; }
  .queue-total { font-size: .875rem; color: #6b7280; margin: .5rem 0 0; }
  .spinner {
    width: 32px; height: 32px; border: 3px solid #d1fae5;
    border-top-color: #056839; border-radius: 50%;
    animation: spin .8s linear infinite; margin: 1rem auto .5rem;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .poll-note { font-size: .8rem; color: #9ca3af; }

  /* Admitted / Jitsi embed view */
  #jitsi-view { display: none; position: fixed; inset: 0; }
  #jitsi-container { width: 100%; height: 100%; }
  .admitted-banner {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: #056839; color: #fff; text-align: center;
    padding: .5rem 1rem; font-size: .9rem; font-weight: 600;
  }
</style>

<!-- ── Waiting View ──────────────────────────────────────────────────────────── -->
<div id="queue-view">
  <div class="queue-card">
    <div class="queue-logo">🏥</div>
    <h1 class="queue-title">คิวรอตรวจ</h1>
    <p class="queue-room" id="room-name-label">กำลังโหลด…</p>

    <div class="queue-num-box" id="queue-num-box">
      <p class="queue-num-label">ลำดับของคุณ</p>
      <p class="queue-num-val" id="my-position">—</p>
      <p class="queue-total" id="queue-total"></p>
    </div>

    <div id="status-waiting">
      <div class="spinner"></div>
      <p class="poll-note">ระบบตรวจสอบคิวทุก 5 วินาที</p>
    </div>

    <div id="status-admitted" style="display:none">
      <p style="color:#056839;font-weight:700;font-size:1rem;margin:.5rem 0 0">✅ ถึงคิวของคุณแล้ว! กำลังเข้าห้องตรวจ…</p>
    </div>
  </div>
</div>

<!-- ── Jitsi View (shown when admitted) ──────────────────────────────────────── -->
<div id="jitsi-view">
  <div class="admitted-banner">🩺 เข้าห้องตรวจแล้ว – <%= patientName %></div>
  <div id="jitsi-container" style="padding-top:40px;box-sizing:border-box;height:100%"></div>
</div>

<script src="https://<%= meetingDomain %>/external_api.js"></script>
<script>
  const roomId      = <%- JSON.stringify(roomId) %>;
  const jwtToken    = <%- JSON.stringify(jwtToken) %>;
  const patientName = <%- JSON.stringify(patientName) %>;
  const domain      = <%- JSON.stringify(meetingDomain) %>;

  let admitted  = false;
  let jitsiApi  = null;

  async function pollQueue() {
    if (admitted) return;
    try {
      const r = await fetch(`/api/exam/${roomId}/queue?jwt=${encodeURIComponent(jwtToken)}`);
      if (!r.ok) return;
      const d = await r.json();

      document.getElementById('room-name-label').textContent = d.roomName || '';
      document.getElementById('my-position').textContent =
        d.status === 'admitted' ? '✅' : (d.position != null ? d.position : '—');
      document.getElementById('queue-total').textContent =
        d.total != null ? `จากทั้งหมด ${d.total} คน` : '';

      if (d.status === 'admitted') {
        admitted = true;
        clearInterval(pollInterval);
        showAdmitted();
      }
    } catch (_) {}
  }

  function showAdmitted() {
    document.getElementById('status-waiting').style.display = 'none';
    document.getElementById('status-admitted').style.display = 'block';

    setTimeout(() => {
      document.getElementById('queue-view').style.display  = 'none';
      document.getElementById('jitsi-view').style.display  = 'block';
      startJitsi();
    }, 1500);
  }

  function startJitsi() {
    jitsiApi = new JitsiMeetExternalAPI(domain, {
      roomName  : roomId,
      width     : '100%',
      height    : '100%',
      parentNode: document.getElementById('jitsi-container'),
      userInfo  : { displayName: patientName },
      configOverwrite: {
        startWithAudioMuted: false,
        startWithVideoMuted: false
      },
      interfaceConfigOverwrite: {
        TOOLBAR_BUTTONS: ['microphone', 'camera', 'hangup', 'chat', 'tileview'],
        SHOW_JITSI_WATERMARK: false
      }
    });
  }

  // Start polling immediately, then every 5s
  pollQueue();
  const pollInterval = setInterval(pollQueue, 5000);
</script>

<%- include('partials/foot') %>
