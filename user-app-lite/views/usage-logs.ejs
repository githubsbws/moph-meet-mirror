<%- include('partials/head', { title: 'สถิติการใช้งาน – MOPH Meet' }) %>

<!-- Navbar -->
<div class="navbar bg-primary text-primary-content shadow px-4 gap-2">
  <div class="flex-1 flex items-center gap-3">
    <a href="/" class="flex items-center gap-2">
      <img src="/images/logo.png" alt="MOPH Meet" class="h-9 bg-white/90 p-1 rounded" onerror="this.style.display='none'" />
    </a>
    <span class="text-lg font-semibold hidden sm:inline">สถิติการใช้งาน</span>
  </div>
  <div class="flex-none gap-3 items-center">
    <a href="/" class="btn btn-sm btn-outline text-primary-content border-primary-content hover:bg-primary-content hover:text-primary">← กลับหน้าหลัก</a>
  </div>
</div>

<main class="container mx-auto p-4 flex flex-col gap-4 max-w-6xl">

  <!-- ── Summary Cards ──────────────────────────────────────────────── -->
  <div id="summary-cards" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
    <div class="card bg-white shadow-sm border border-base-200">
      <div class="card-body p-4 items-center text-center">
        <div class="text-2xl font-bold text-primary" id="stat-rooms">—</div>
        <div class="text-xs text-base-content/60">ห้องทั้งหมด</div>
      </div>
    </div>
    <div class="card bg-white shadow-sm border border-base-200">
      <div class="card-body p-4 items-center text-center">
        <div class="text-2xl font-bold text-accent" id="stat-patients">—</div>
        <div class="text-xs text-base-content/60">ผู้ป่วยเข้าคิว</div>
      </div>
    </div>
    <div class="card bg-white shadow-sm border border-base-200">
      <div class="card-body p-4 items-center text-center">
        <div class="text-2xl font-bold text-success" id="stat-admitted">—</div>
        <div class="text-xs text-base-content/60">รับเข้าตรวจ</div>
      </div>
    </div>
    <div class="card bg-white shadow-sm border border-base-200">
      <div class="card-body p-4 items-center text-center">
        <div class="text-2xl font-bold text-info" id="stat-doctors">—</div>
        <div class="text-xs text-base-content/60">แพทย์ทั้งหมด</div>
      </div>
    </div>
    <div class="card bg-white shadow-sm border border-base-200">
      <div class="card-body p-4 items-center text-center">
        <div class="text-2xl font-bold text-warning" id="stat-today">—</div>
        <div class="text-xs text-base-content/60">วันนี้</div>
      </div>
    </div>
    <div class="card bg-white shadow-sm border border-base-200">
      <div class="card-body p-4 items-center text-center">
        <div class="text-2xl font-bold text-secondary-content" id="stat-month">—</div>
        <div class="text-xs text-base-content/60">เดือนนี้</div>
      </div>
    </div>
  </div>

  <!-- ── Charts Row ─────────────────────────────────────────────────── -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

    <!-- Daily Chart -->
    <div class="card bg-white shadow-sm border border-base-200">
      <div class="card-body p-4">
        <div class="flex items-center justify-between mb-2">
          <h2 class="card-title text-sm">📊 รายวัน (30 วัน)</h2>
          <select id="daily-days" class="select select-bordered select-xs" onchange="loadDaily()">
            <option value="7">7 วัน</option>
            <option value="14">14 วัน</option>
            <option value="30" selected>30 วัน</option>
            <option value="90">90 วัน</option>
          </select>
        </div>
        <canvas id="chart-daily" height="220"></canvas>
      </div>
    </div>

    <!-- Monthly Chart -->
    <div class="card bg-white shadow-sm border border-base-200">
      <div class="card-body p-4">
        <div class="flex items-center justify-between mb-2">
          <h2 class="card-title text-sm">📈 รายเดือน (12 เดือน)</h2>
          <select id="monthly-months" class="select select-bordered select-xs" onchange="loadMonthly()">
            <option value="6">6 เดือน</option>
            <option value="12" selected>12 เดือน</option>
            <option value="24">24 เดือน</option>
          </select>
        </div>
        <canvas id="chart-monthly" height="220"></canvas>
      </div>
    </div>
  </div>

  <!-- ── Doctor Table ───────────────────────────────────────────────── -->
  <div class="card bg-white shadow-sm border border-base-200">
    <div class="card-body p-4">
      <div class="flex items-center justify-between mb-2">
        <h2 class="card-title text-sm">👨‍⚕️ การใช้งานรายแพทย์</h2>
        <select id="doctor-months" class="select select-bordered select-xs" onchange="loadDoctors()">
          <option value="1">1 เดือน</option>
          <option value="3" selected>3 เดือน</option>
          <option value="6">6 เดือน</option>
          <option value="12">12 เดือน</option>
        </select>
      </div>
      <div class="overflow-x-auto">
        <table class="table table-sm table-zebra w-full">
          <thead>
            <tr>
              <th>#</th>
              <th>แพทย์</th>
              <th>รหัส (CID)</th>
              <th class="text-center">สร้างห้อง</th>
              <th class="text-center">รับตรวจ</th>
              <th class="text-center">ส่งลิงก์</th>
              <th class="text-center">รวม</th>
              <th>ใช้งานล่าสุด</th>
            </tr>
          </thead>
          <tbody id="doctor-table-body">
            <tr><td colspan="8" class="text-center text-base-content/40 py-8">กำลังโหลด...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ── Recent Activity ────────────────────────────────────────────── -->
  <div class="card bg-white shadow-sm border border-base-200">
    <div class="card-body p-4">
      <div class="flex items-center justify-between mb-2">
        <h2 class="card-title text-sm">🕐 กิจกรรมล่าสุด</h2>
        <button class="btn btn-xs btn-outline" onclick="loadRecent()">รีเฟรช</button>
      </div>
      <div class="overflow-x-auto max-h-80 overflow-y-auto">
        <table class="table table-xs w-full">
          <thead class="sticky top-0 bg-white">
            <tr>
              <th>เวลา</th>
              <th>เหตุการณ์</th>
              <th>ห้อง</th>
              <th>แพทย์</th>
              <th>ผู้ป่วย</th>
            </tr>
          </thead>
          <tbody id="recent-table-body">
            <tr><td colspan="5" class="text-center text-base-content/40 py-8">กำลังโหลด...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ── Transparency Note ──────────────────────────────────────────── -->
  <div class="alert bg-base-200 border-base-300 text-xs text-base-content/60">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-info shrink-0 w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    <span>หน้านี้แสดงสถิติการใช้งานระบบ Telemedicine ของกระทรวงสาธารณสุข เพื่อความโปร่งใสในการใช้ทรัพยากร — ข้อมูลอัปเดตอัตโนมัติทุกครั้งที่เปิดหน้า</span>
  </div>

</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
const API = '/api/usage-logs';
const EVENT_LABELS = {
  room_created: 'สร้างห้อง',
  reserved_room_created: 'สร้างห้อง (นัดหมาย)',
  patient_joined_queue: 'ผู้ป่วยเข้าคิว',
  patient_admitted: 'รับเข้าตรวจ',
  invite_generated: 'ส่งลิงก์เชิญ',
  reserved_token_issued: 'ออก Token นัดหมาย',
};
const PRIMARY  = '#056839';
const ACCENT   = '#0d9e5c';
const SUCCESS  = '#22c55e';
const INFO     = '#3b82f6';

let dailyChart, monthlyChart;

// ── Summary ───────────────────────────────────────
async function loadSummary() {
  try {
    const r = await fetch(`${API}/summary`);
    const d = await r.json();
    document.getElementById('stat-rooms').textContent    = d.rooms?.toLocaleString()    ?? '—';
    document.getElementById('stat-patients').textContent  = d.patients?.toLocaleString()  ?? '—';
    document.getElementById('stat-admitted').textContent   = d.admitted?.toLocaleString()  ?? '—';
    document.getElementById('stat-doctors').textContent    = d.doctors?.toLocaleString()   ?? '—';
    document.getElementById('stat-today').textContent      = d.today?.toLocaleString()     ?? '—';
    document.getElementById('stat-month').textContent      = d.thisMonth?.toLocaleString() ?? '—';
  } catch (e) { console.error('summary', e); }
}

// ── Daily ─────────────────────────────────────────
async function loadDaily() {
  const days = document.getElementById('daily-days').value;
  try {
    const r = await fetch(`${API}/daily?days=${days}`);
    const rows = await r.json();
    const labels   = rows.map(r => r.day?.slice(5) || '');
    const rooms    = rows.map(r => r.rooms    || 0);
    const patients = rows.map(r => r.patients || 0);
    const admitted = rows.map(r => r.admitted || 0);

    if (dailyChart) dailyChart.destroy();
    dailyChart = new Chart(document.getElementById('chart-daily'), {
      type: 'bar',
      data: {
        labels,
        datasets: [
          { label: 'ห้อง',     data: rooms,    backgroundColor: PRIMARY },
          { label: 'เข้าคิว',   data: patients, backgroundColor: ACCENT  },
          { label: 'รับตรวจ',   data: admitted, backgroundColor: SUCCESS },
        ]
      },
      options: {
        responsive: true,
        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } } },
        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
      }
    });
  } catch (e) { console.error('daily', e); }
}

// ── Monthly ───────────────────────────────────────
async function loadMonthly() {
  const months = document.getElementById('monthly-months').value;
  try {
    const r = await fetch(`${API}/monthly?months=${months}`);
    const rows = await r.json();
    const labels   = rows.map(r => r.month || '');
    const rooms    = rows.map(r => r.rooms    || 0);
    const patients = rows.map(r => r.patients || 0);
    const admitted = rows.map(r => r.admitted || 0);
    const doctors  = rows.map(r => r.doctors  || 0);

    if (monthlyChart) monthlyChart.destroy();
    monthlyChart = new Chart(document.getElementById('chart-monthly'), {
      type: 'line',
      data: {
        labels,
        datasets: [
          { label: 'ห้อง',     data: rooms,    borderColor: PRIMARY, backgroundColor: PRIMARY + '33', fill: true, tension: 0.3 },
          { label: 'เข้าคิว',   data: patients, borderColor: ACCENT,  backgroundColor: ACCENT  + '33', fill: true, tension: 0.3 },
          { label: 'รับตรวจ',   data: admitted, borderColor: SUCCESS, tension: 0.3, borderDash: [5,3] },
          { label: 'แพทย์',    data: doctors,  borderColor: INFO,    tension: 0.3, borderDash: [2,2] },
        ]
      },
      options: {
        responsive: true,
        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } } },
        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
      }
    });
  } catch (e) { console.error('monthly', e); }
}

// ── Doctors ───────────────────────────────────────
async function loadDoctors() {
  const months = document.getElementById('doctor-months').value;
  try {
    const r = await fetch(`${API}/by-doctor?months=${months}`);
    const rows = await r.json();
    const tbody = document.getElementById('doctor-table-body');
    if (!rows.length) {
      tbody.innerHTML = '<tr><td colspan="8" class="text-center text-base-content/40 py-8">ยังไม่มีข้อมูล</td></tr>';
      return;
    }
    tbody.innerHTML = rows.map((d, i) => `
      <tr>
        <td>${i + 1}</td>
        <td class="font-medium">${esc(d.doctor_name || '—')}</td>
        <td class="text-xs font-mono">${esc(d.doctor_id || '—')}</td>
        <td class="text-center">${d.rooms}</td>
        <td class="text-center">${d.admitted}</td>
        <td class="text-center">${d.invites}</td>
        <td class="text-center font-semibold">${d.total_events}</td>
        <td class="text-xs">${fmtDate(d.last_seen)}</td>
      </tr>
    `).join('');
  } catch (e) { console.error('doctors', e); }
}

// ── Recent ────────────────────────────────────────
async function loadRecent() {
  try {
    const r = await fetch(`${API}/recent?limit=100`);
    const rows = await r.json();
    const tbody = document.getElementById('recent-table-body');
    if (!rows.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="text-center text-base-content/40 py-8">ยังไม่มีข้อมูล</td></tr>';
      return;
    }
    tbody.innerHTML = rows.map(e => `
      <tr>
        <td class="whitespace-nowrap text-xs">${fmtDate(e.ts)}</td>
        <td><span class="badge badge-sm ${eventBadge(e.event)}">${EVENT_LABELS[e.event] || e.event}</span></td>
        <td class="text-xs">${esc(e.room_name || e.room_id || '—')}</td>
        <td class="text-xs">${esc(e.doctor_name || e.doctor_id || '—')}</td>
        <td class="text-xs">${esc(e.patient_name || '—')}</td>
      </tr>
    `).join('');
  } catch (e) { console.error('recent', e); }
}

function eventBadge(ev) {
  if (ev.includes('created'))  return 'badge-primary';
  if (ev.includes('admitted')) return 'badge-success';
  if (ev.includes('queue'))    return 'badge-accent';
  if (ev.includes('invite'))   return 'badge-info';
  if (ev.includes('token'))    return 'badge-warning';
  return 'badge-ghost';
}

function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

function fmtDate(iso) {
  if (!iso) return '—';
  try {
    const d = new Date(iso);
    if (isNaN(d)) return iso;
    return d.toLocaleDateString('th-TH', { day:'2-digit', month:'short', year:'2-digit' })
         + ' ' + d.toLocaleTimeString('th-TH', { hour:'2-digit', minute:'2-digit' });
  } catch { return iso; }
}

// ── Init ──────────────────────────────────────────
loadSummary();
loadDaily();
loadMonthly();
loadDoctors();
loadRecent();
</script>

<%- include('partials/foot') %>
